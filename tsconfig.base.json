{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@hub/contracts": ["./packages/contracts/src/index.ts"],
      "@hub/solana": ["./packages/solana/src/index.ts"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "packages/**/*",
    "services/**/*"
  ]
}
