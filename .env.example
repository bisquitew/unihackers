# Example environment variables for the Timișoara City Hub.
# Copy to .env and fill in your own values. Never commit .env.

# P4: assistant (Gemini), voice (ElevenLabs), Living Labs survey ingest
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
FEEDBACK_INGEST_TOKEN=

# P3: Solana organizer keypair (devnet)
SOLANA_ORGANIZER_SECRET_KEY=[your_64_byte_array_here]
SOLANA_ORGANIZER_PUBLIC_KEY=your_organizer_public_key_here
