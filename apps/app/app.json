{
  "expo": {
    "name": "Timișoara Hub",
    "slug": "timisoara-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "timisoarahub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF3D7F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
