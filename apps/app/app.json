{
  "expo": {
    "name": "hop",
    "slug": "timisoara-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "timisoarahub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF3D7F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "hop uses your location to show where you are on the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
