{
  "name": "unihackers-timisoara-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Timișoara City Hub — UNIHACK 2026",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types services/api/src/server.ts",
    "dev:api": "npm run dev --prefix services/api",
    "dev:workers": "node --experimental-strip-types services/workers/src/index.ts",
    "dev:app": "npm run start --prefix apps/app",
    "dev:app:tunnel": "npm run start --prefix apps/app -- --tunnel ngrok",
    "dev:app:wifi": "npm run start --prefix apps/app -- --host 10.109.24.138",
    "test:solana": "node --experimental-strip-types scripts/test-solana-real.ts",
    "test:p2": "python3 scripts/test_p2.py",
    "demo:auth0": "python3 scripts/demo_auth0.py",
    "start": "node --experimental-strip-types services/api/src/server.ts",
    "build": "npm run build --workspaces --if-present",
    "test": "python3 scripts/test_p2.py"
  },
  "keywords": [
    "timisoara",
    "unihack",
    "community-hub"
  ],
  "author": "UniHackers Team",
  "license": "MIT",
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "typescript": "^5.6.3"
  }
}
